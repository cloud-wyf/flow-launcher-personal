<Window x:Class="Flow.Launcher.Plugin.PersonalBookmarks.Views.BookmarkTagsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="书签标签" Width="800" Height="560" MinWidth="660" MinHeight="460"
    WindowStartupLocation="CenterOwner" Background="{DynamicResource Color01B}"
    Foreground="{DynamicResource Color05B}" FontFamily="{DynamicResource SettingWindowFont}" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0 0 0 12">
            <TextBlock Text="书签标签" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="250" HorizontalAlignment="Right" DockPanel.Dock="Right"
                     TextChanged="Filter_Changed" ToolTip="按书签名称、网址或标签筛选"
                     AutomationProperties.AutomationId="BookmarkTagFilter" />
        </DockPanel>
        <ListView x:Name="BookmarkList" Grid.Row="1" SelectionChanged="Bookmark_Changed"
                  Style="{DynamicResource {x:Static GridView.GridViewStyleKey}}"
                  AutomationProperties.AutomationId="BookmarkTagList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="书签名称" DisplayMemberBinding="{Binding Name}" Width="230" />
                    <GridViewColumn Header="网址" DisplayMemberBinding="{Binding Url}" Width="250" />
                    <GridViewColumn Header="标签" DisplayMemberBinding="{Binding Tags}" Width="210" />
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Margin="0 12 0 8">
            <TextBlock x:Name="SelectedUrl" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AutomaticTags" Margin="0 6 0 0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="BookmarkAutomaticTags"
                       Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
            <Grid Margin="0 8 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="手动标签" Margin="{DynamicResource SettingPanelItemRightMargin}" VerticalAlignment="Center" />
                <TextBox x:Name="TagsBox" Grid.Column="1" IsEnabled="False"
                         AutomationProperties.AutomationId="BookmarkTagsInput" />
                <Button x:Name="SaveButton" Grid.Column="2" Width="100" IsEnabled="False"
                        Margin="{DynamicResource SettingPanelItemLeftMargin}" Content="保存标签" Click="Save_Click"
                        AutomationProperties.AutomationId="BookmarkTagsSave" />
            </Grid>
            <TextBlock Text="逗号或分号分隔，例如：开发,文档,云服务。留空并保存可清除手动标签，目录标签仍然保留。"
                       TextWrapping="Wrap" Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="BookmarkTagsStatus" />
        <TextBlock Grid.Row="4" Margin="0 8 0 0" TextWrapping="Wrap"
                   Text="各级书签文件夹名称自动作为目录标签，随浏览器书签更新。手动标签只保存在 Flow 本地，同一网址共享，保存后下次搜索生效。"
                   Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
    </Grid>
</Window>
