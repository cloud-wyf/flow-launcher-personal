<UserControl x:Class="Flow.Launcher.Plugin.NoteContent.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{DynamicResource SettingPanelMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="搜索目录" VerticalAlignment="Top"
                   Margin="{DynamicResource SettingPanelItemRightTopBottomMargin}"
                   Foreground="{DynamicResource Color05B}" />
        <StackPanel Grid.Column="1" Margin="{DynamicResource SettingPanelItemLeftTopBottomMargin}">
            <TextBox x:Name="DirectoriesBox" Width="{DynamicResource SettingPanelPathTextBoxWidth}"
                     MinHeight="{DynamicResource SettingPanelAreaTextBoxMinHeight}"
                     HorizontalAlignment="Left" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="NoteContentDirectories" />
            <TextBlock Text="每行一个目录，包含所有子目录。" TextWrapping="Wrap"
                       Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
            <Button x:Name="AddFolderButton" Margin="{DynamicResource SettingPanelItemTopBottomMargin}"
                    HorizontalAlignment="Left" Content="添加文件夹…" Click="AddFolder_Click"
                    AutomationProperties.AutomationId="NoteContentAddFolder" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="排除目录" VerticalAlignment="Top"
                   Margin="{DynamicResource SettingPanelItemRightTopBottomMargin}"
                   Foreground="{DynamicResource Color05B}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="{DynamicResource SettingPanelItemLeftTopBottomMargin}">
            <TextBox x:Name="ExcludedDirectoriesBox" Width="{DynamicResource SettingPanelPathTextBoxWidth}"
                     MinHeight="{DynamicResource SettingPanelAreaTextBoxMinHeight}"
                     HorizontalAlignment="Left" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="NoteContentExcludedDirectories" />
            <TextBlock Text="每行一个绝对目录，跳过该目录及所有子目录。留空表示不额外排除；.git 目录仍默认跳过。" TextWrapping="Wrap"
                       Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
            <Button Margin="{DynamicResource SettingPanelItemTopBottomMargin}" HorizontalAlignment="Left"
                    Content="添加排除文件夹…" Click="AddExcludedFolder_Click"
                    AutomationProperties.AutomationId="NoteContentAddExcludedFolder" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="文件类型" VerticalAlignment="Top"
                   Margin="{DynamicResource SettingPanelItemRightTopBottomMargin}"
                   Foreground="{DynamicResource Color05B}" />
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="{DynamicResource SettingPanelItemLeftTopBottomMargin}">
            <TextBox x:Name="FileTypesBox" Width="{DynamicResource SettingPanelPathTextBoxWidth}"
                     MinWidth="{DynamicResource SettingPanelTextBoxMinWidth}" HorizontalAlignment="Left"
                     AutomationProperties.AutomationId="NoteContentFileTypes" />
            <TextBlock Text="分号分隔，如 *.md;*.txt;*.json；* 表示不限扩展名。" TextWrapping="Wrap"
                       Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
            <TextBlock Text="搜索文本文件；PDF、Word 等格式需要另行提取正文。" TextWrapping="Wrap"
                       Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
        </StackPanel>

        <Separator Grid.Row="3" Grid.ColumnSpan="2" Style="{DynamicResource SettingPanelSeparatorStyle}" />

        <TextBlock Grid.Row="4" Text="结果上限" VerticalAlignment="Center"
                   Margin="{DynamicResource SettingPanelItemRightTopBottomMargin}"
                   Foreground="{DynamicResource Color05B}" />
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                    Margin="{DynamicResource SettingPanelItemLeftTopBottomMargin}">
            <TextBox x:Name="MaxResultsBox" Width="100" AutomationProperties.AutomationId="NoteContentMaxResults" />
            <TextBlock Text="1–2000 个文件" VerticalAlignment="Center"
                       Margin="{DynamicResource SettingPanelItemLeftMargin}"
                       Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
        </StackPanel>
        <TextBlock Grid.Row="5" Text="超时时间" VerticalAlignment="Center"
                   Margin="{DynamicResource SettingPanelItemRightTopBottomMargin}"
                   Foreground="{DynamicResource Color05B}" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"
                    Margin="{DynamicResource SettingPanelItemLeftTopBottomMargin}">
            <TextBox x:Name="TimeoutBox" Width="100" AutomationProperties.AutomationId="NoteContentTimeout" />
            <TextBlock Text="1–60 秒" VerticalAlignment="Center"
                       Margin="{DynamicResource SettingPanelItemLeftMargin}"
                       Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
        </StackPanel>

        <Button x:Name="SaveButton" Grid.Row="6" Grid.Column="1" Width="100"
                Margin="{DynamicResource SettingPanelItemLeftTopBottomMargin}" HorizontalAlignment="Right"
                Content="保存设置" Click="Save_Click" AutomationProperties.AutomationId="NoteContentSave" />
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="{DynamicResource SettingPanelItemTopBottomMargin}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Color05B}"
                       AutomationProperties.AutomationId="NoteContentStatus" />
            <TextBlock Text="保存后下一次搜索生效，无需重启。" TextWrapping="Wrap"
                       Style="{DynamicResource SettingPanelTextBlockDescriptionStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
